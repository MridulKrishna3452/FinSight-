# Copy this file to .env and adjust as needed. All values below are safe local defaults.

# ---- Postgres ----
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_DB=finsight
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend (apps/api) ----
DATABASE_URL=postgresql+psycopg://finsight:finsight@postgres:5432/finsight
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
CSV_MAX_SIZE_MB=5
ANOMALY_THRESHOLD=0.7
COOKIE_SECURE=false
REFRESH_COOKIE_NAME=finsight_refresh_token
RATE_LIMIT_AUTH=10/minute
ENVIRONMENT=development
API_PORT=8000

# ---- Frontend (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
WEB_PORT=3000
